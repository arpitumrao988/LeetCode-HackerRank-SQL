with check1 as (
    select tiv_2015
    from insurance 
    group by tiv_2015
    having count(*)>1
), ellig_pid as(
        select pid
        from insurance 
        where pid not in  (
        select i1.pid
        from insurance i1 join(
        select lat, lon,count(*)
        from insurance 
        group by lat,lon 
        having count(*)>1) A
        on i1.lat = A.lat
        and i1.lon = A.lon)
)

  select round(sum(tiv_2016),2) as tiv_2016
  from insurance 
  where pid in (select pid from ellig_pid)
  and  tiv_2015 in (select tiv_2015 from check1); 

